{
  "schemaVersion": 1,
  "id": "mobsenses",
  "version": "${version}",
  "name": "Mob Senses",
  "icon": "assets/mobsenses/icon.png",
  "description": "Mobs hear your steps, blocks, doors and fights through walls, see your light and, with Simple Voice Chat, hear your voice. Works on the server alone; vanilla clients can join.",
  "authors": [
    "Shamanalle"
  ],
  "contact": {
    "homepage": "https://github.com/Shamanalle/mob-senses",
    "sources": "https://github.com/Shamanalle/mob-senses",
    "issues": "https://github.com/Shamanalle/mob-senses/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kasper.mobsenses.MobSensesFabric"
    ],
    "client": [
      "com.kasper.mobsenses.MobSensesClient"
    ],
    "voicechat": [
      "com.kasper.mobsenses.MobSensesVoicePlugin"
    ]
  },
  "mixins": [
    "mobsenses.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.10",
    "fabric-api": "*",
    "minecraft": ">=1.20.5 <=1.20.6",
    "java": ">=21"
  },
  "suggests": {
    "voicechat": "*"
  }
}
